{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"],

    /**
     * Required by the Vercel serverless function at api/index.ts.
     *
     * NestJS uses legacy TypeScript decorators. Vercel's bundler reads the
     * tsconfig at the PROJECT ROOT, and without these it compiles them with
     * the modern decorator spec instead — @Controller() then throws
     * "Cannot read properties of undefined (reading 'value')" at import time,
     * before a single route is registered. That surfaces as an opaque
     * FUNCTION_INVOCATION_FAILED with no useful log line.
     *
     * Reproduced locally by loading api/index.ts without these flags, and
     * fixed by supplying them. Do not remove: the API's own tsconfig sets
     * them too, but that file is never consulted for the root-level function.
     */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["api/**/*.ts", "apps/api/src/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "build"]
}
