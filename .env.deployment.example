# ---------------------------------------------------------------------------
# Split deployment: web on Vercel, API on Railway.
#
# This file is a CHECKLIST, not a file to deploy. Set these in each host's
# dashboard. Never commit real secrets.
#
# Replace throughout:
#   <web-domain>  e.g. billing-app.vercel.app
#   <api-domain>  e.g. billing-api.up.railway.app
# ---------------------------------------------------------------------------


# === VERCEL (web) ==========================================================
# Both are NEXT_PUBLIC_*, so they are inlined at BUILD time and are
# world-readable. They must exist BEFORE the build; changing one needs a
# redeploy, not a restart. Never put a secret in a NEXT_PUBLIC_ variable.
#
# No trailing slash: the API client appends "/api/v1" directly.
NEXT_PUBLIC_API_URL=https://<api-domain>
NEXT_PUBLIC_APP_URL=https://<web-domain>


# === RAILWAY (API) =========================================================
NODE_ENV=production
APP_NAME=BillingApp
LOG_LEVEL=info

# PORT is injected by Railway and overrides API_PORT — do not set either.
APP_URL=https://<web-domain>
API_URL=https://<api-domain>

# --- Database (Supabase) ---
# Runtime role. MUST NOT have BYPASSRLS: RLS applying to this connection IS
# the tenant isolation guarantee. Use the transaction pooler (6543).
DATABASE_URL=postgresql://billing_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=30

# Migrations only, never at runtime. REQUIRES BYPASSRLS, and a session
# connection (5432) — Prisma Migrate cannot run through the transaction pooler.
DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth ---
# Generate: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=
# The API's own origin — Better Auth mounts at <this>/api/v1/auth.
BETTER_AUTH_URL=https://<api-domain>
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# --- Cross-site cookies: REQUIRED for this split topology ---
# Vercel and Railway are different registrable domains, so the browser treats
# them as cross-site and will NOT send a SameSite=Lax cookie to the API. The
# symptom is sign-in succeeding and then every request returning 401.
# Setting this switches the session cookie to SameSite=None; Secure.
# Leave false (or unset) for local development or single-host deployments.
CROSS_SITE_COOKIES=true

# Must NOT include localhost or a wildcard in production — startup rejects both.
CORS_ORIGINS=https://<web-domain>

# Leave EMPTY for a split deployment. A Domain= attribute cannot span two
# unrelated registrable domains; setting it to either host silently prevents
# the cookie being stored. A host-only cookie is what works here.
COOKIE_DOMAIN=

# openssl rand -base64 32
ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Optional ---
# Nothing in the API imports bullmq/ioredis today, so Redis is not required.
# REDIS_URL=redis://...
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=
