# ---------------------------------------------------------------------------
# Vercel deployment — web and API on ONE project, one origin.
#
# vercel.json rewrites /api/v1/* to the NestJS serverless function in api/,
# and everything else to Next.js. Because both share an origin, the session
# cookie stays SameSite=Lax and no CORS configuration is needed.
#
# This file is a CHECKLIST. Set these in Vercel → Settings → Environment
# Variables. Never commit real secrets.
#
# Replace <domain> with your Vercel domain, e.g. billing-app.vercel.app
# ---------------------------------------------------------------------------

# === Public (inlined into the browser bundle at BUILD time) ================
# Both are deliberately EMPTY so the client uses relative, same-origin URLs.
# Do not set them to a localhost address: whatever is here is compiled into a
# world-readable bundle, which is what made the first deployment call the
# visitor's own machine.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=


# === Server-side ==========================================================
NODE_ENV=production
APP_NAME=BillingApp
LOG_LEVEL=info

# Same origin for both — the API is mounted under the web domain.
APP_URL=https://<domain>
API_URL=https://<domain>

# --- Database (Supabase) ---
# Runtime role. MUST NOT have BYPASSRLS: RLS applying to this connection IS
# the tenant isolation guarantee. Use the transaction pooler (6543).
#
# connection_limit is deliberately LOW for serverless: every warm function
# instance holds its own pool, so a high per-instance limit multiplied by many
# instances exhausts Postgres. The pooler is what absorbs the concurrency.
DATABASE_URL=postgresql://billing_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20

# Migrations only, never at runtime. REQUIRES BYPASSRLS and a session
# connection (5432) — Prisma Migrate cannot run through the transaction pooler.
# Run migrations from your machine, not from a function.
DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth ---
# Generate: openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=
# The origin Better Auth is served from — same domain, it mounts at /api/v1/auth.
BETTER_AUTH_URL=https://<domain>
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# Same-origin, so the cookie stays SameSite=Lax. Leave false: SameSite=None
# would widen exposure for no benefit here.
CROSS_SITE_COOKIES=false

# Must not include localhost or a wildcard in production — startup rejects both.
CORS_ORIGINS=https://<domain>

# Leave EMPTY. A host-only cookie is correct for a single domain.
COOKIE_DOMAIN=

# openssl rand -base64 32
ENCRYPTION_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- PDF rendering (REQUIRED) ---------------------------------------------
# Serverless functions cannot run Chromium — a browser build alone exceeds
# Vercel's 250MB unzipped function limit — so PDFs render remotely.
#
# Sign up at browserless.io and paste the API token. Without it the API
# refuses to start rather than failing on the first customer download.
#
# NOTE: the document HTML — customer names, addresses, line items, totals —
# is sent to Browserless to be rendered. Nothing is stored there, but this is
# a data processor relationship and belongs in the handover documentation.
PDF_RENDERER=playwright
# BROWSERLESS_TOKEN=   # only needed if PDF_RENDERER=browserless
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io
# Kept under the function's maxDuration (60s in vercel.json) so a hung render
# returns our error with a request id, not an opaque platform 504.
PDF_RENDER_TIMEOUT_MS=25000

# --- Optional ---
# Nothing in the API imports bullmq/ioredis today, so Redis is not required.
# REDIS_URL=redis://...
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=
