# ---------------------------------------------------------------------------
# Billing Platform — environment template
#
# Copy to .env and fill in. NEVER commit .env or real secrets.
# Only variables prefixed NEXT_PUBLIC_ reach the browser bundle; everything
# else stays server-side. Do not add a secret to a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=BillingApp
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Browser-exposed. Public by design — must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://billing_app:billing_app@localhost:5432/billing_dev

# Owns the schema and bypasses RLS. Used only by migrations, never at runtime.
DATABASE_MIGRATION_URL=postgresql://billing_owner:billing_owner@localhost:5432/billing_dev

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# --- Redis / queue ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (Phase 2) ----------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=billing-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing; real S3 uses virtual-host style.
S3_FORCE_PATH_STYLE=true
# Lifetime of generated download links. Short by design (Security Doc §35).
S3_SIGNED_URL_TTL_SECONDS=300

# --- Email (Phase 2) --------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

# --- Security ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
