{
  "name": "billing-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "postinstall": "pnpm --filter @billing/database generate",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @billing/database generate",
    "db:migrate": "pnpm --filter @billing/database migrate",
    "db:migrate:deploy": "pnpm --filter @billing/database migrate:deploy",
    "db:seed": "pnpm --filter @billing/database seed",
    "db:reset": "pnpm --filter @billing/database reset",
    "db:studio": "pnpm --filter @billing/database studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "bash tests/integration/tenant-isolation.sh && bash tests/integration/customers.sh && bash tests/integration/quotations.sh && bash tests/integration/invoices.sh && bash tests/integration/payments.sh && bash tests/integration/search.sh && bash tests/integration/dashboard.sh && bash tests/integration/pdf.sh && bash tests/integration/integrity.sh",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:reset:demo": "dotenv -e .env -- tsx scripts/reset-demo-data.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^7.4.4",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@billing/api": "workspace:*",
    "@billing/config": "workspace:*",
    "@billing/database": "workspace:*",
    "next": "15.5.23",
    "reflect-metadata": "^0.2.2"
  }
}
