{
  "name": "billing-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @billing/database generate",
    "db:migrate": "pnpm --filter @billing/database migrate",
    "db:migrate:deploy": "pnpm --filter @billing/database migrate:deploy",
    "db:seed": "pnpm --filter @billing/database seed",
    "db:reset": "pnpm --filter @billing/database reset",
    "db:studio": "pnpm --filter @billing/database studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "bash tests/integration/tenant-isolation.sh && bash tests/integration/customers.sh",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
